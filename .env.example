# =============================================================================
# Kosply Admin (frontend) — environment template
# Copy this file to `.env.local` and fill in the values for your machine.
# =============================================================================

# Base URL of the Kosply Express backend.
# Server Components, Server Actions and proxy route handlers call this URL
# server-to-server, so it is never exposed to the browser.
API_URL=http://localhost:3000

# Feature flag for the admin login gate.
#   false → dashboard is open (login flow is still in progress / local dev)
#   true  → every dashboard route requires a session, enforced by proxy.js
AUTH_ENABLED=false
